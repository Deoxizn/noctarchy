[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = linux*
Target = linux-*-headers

[Action]
Description = noctarchy: re-apply Plymouth boot splash after kernel update
When = PostTransaction
Exec = /bin/bash -c 'grep -q "^Theme=noctarchy" /etc/plymouth/plymouthd.conf 2>/dev/null && exit 0; SPLASH_BIN="/home/${SUDO_USER:-$(logname)}/.local/bin/noctarchy-splash"; [ -x "$SPLASH_BIN" ] && "$SPLASH_BIN" run adopt || echo "[noctarchy-splash] not found for user ${SUDO_USER:-$(logname)}" >&2'
