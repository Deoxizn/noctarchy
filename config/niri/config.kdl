// Noctarchy — Niri config
// https://github.com/deoxizn/noctarchy
//
// Based on Omarchy keybind conventions adapted for Niri's scrollable tiling.
// This file is managed by noctarchy — personal edits go in a separate include
// or above the managed sections.

// ──────────────────────────────────────────────
// Environment
// ──────────────────────────────────────────────

environment {
    QT_QPA_PLATFORM "wayland;xcb"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    DISPLAY null
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    _JAVA_AWT_WM_NONREPARENTING "1"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    MOZ_ENABLE_WAYLAND "1"
    CLUTTER_BACKEND "wayland"
    SDL_VIDEODRIVER "wayland"
    GDK_BACKEND "wayland,x11"
}

// ──────────────────────────────────────────────
// Cursor
// ──────────────────────────────────────────────

cursor {
    xcursor-theme "breeze_cursors"
    xcursor-size 24
    hide-when-typing
    hide-after-inactive-ms 1000
}

// ──────────────────────────────────────────────
// Input
// ──────────────────────────────────────────────

input {
    keyboard {
        xkb {
            layout "us"
            // options "ctrl:nocaps"
        }
    }

    touchpad {
        tap
        natural-scroll
        // disabled-while-typing is on by default
    }

    mouse {
        // natural-scroll
    }

    // focus-follows-mouse
    // focus-follows-mouse-delay 250
    // scroll-factor 3
}

// ──────────────────────────────────────────────
// Layout
// ──────────────────────────────────────────────

layout {
    gaps 16
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 4
        active-color "#f472b6"
        inactive-color "#1a1a2e"
    }

    border {
        on
        width 2
        active-color "#60a5fa"
        inactive-color "#1a1a2e"
        urgent-color "#f87171"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

// ──────────────────────────────────────────────
// Animations
// ──────────────────────────────────────────────

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
}

// ──────────────────────────────────────────────
// Overview
// ──────────────────────────────────────────────

overview {
    zoom 0.5
    backdrop-color "#262626"
}

// ──────────────────────────────────────────────
// Named workspaces
// ──────────────────────────────────────────────

workspace "browser"
workspace "code"
workspace "chat"
workspace "media"

// ──────────────────────────────────────────────
// Keybindings
// Niri has NO default binds — you must define ALL of them.
// Mirrors Omarchy conventions where possible (SUPER = Mod).
// ──────────────────────────────────────────────

binds {
    // ── Launcher & menus ──
    Mod+D { spawn "fuzzel"; }
    Mod+Space { spawn "noctalia" "ipc" "launcher" "toggle"; }
    Mod+Alt+Space { spawn "noctarchy-menu"; }
    Mod+K { spawn "noctarchy-keybinds"; }
    Mod+Escape { spawn "noctarchy-power"; }

    // ── Terminal ──
    Mod+T { spawn "alacritty"; }
    Mod+Shift+T { spawn "foot"; }

    // ── Close & quit ──
    Mod+Q { close-window; }
    Mod+Shift+E { quit; confirm = "Quit Niri?"; }

    // ── Focus (arrow keys) ──
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }

    // ── Move (arrow keys) ──
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Up { move-window-up; }

    // ── Focus (vim-style) ──
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    // ── Move (vim-style) ──
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }

    // ── Workspaces ──
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace "browser"; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace "browser"; }

    // ── Workspace navigation ──
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    // ── Column management ──
    Mod+BracketLeft { consume-window-into-column; }
    Mod+BracketRight { expel-window-from-column; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { toggle-column-tabbed-display; }

    // ── Floating ──
    Mod+Shift+Space { toggle-window-floating; }
    Mod+P { focus-floating; }
    Mod+Shift+F { focus-tiling; }

    // ── Screenshots ──
    Mod+Print { spawn "grim" "-g" "$(slurp)" - | "wl-copy"; }
    Ctrl+Print { spawn "grim" - | "wl-copy"; }
    Alt+Print { spawn "grim" -g "$(slurp)" ~/Pictures/Screenshots/"$(date +%Y-%m-%d_%H-%M-%S).png"; }

    // ── Media keys ──
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; allow-when-locked=true; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; allow-when-locked=true; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; allow-when-locked=true; }
    XF86AudioMicMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; allow-when-locked=true; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; allow-when-locked=true; }
    XF86AudioPrev { spawn "playerctl" "previous"; allow-when-locked=true; }
    XF86AudioNext { spawn "playerctl" "next"; allow-when-locked=true; }

    // ── Brightness ──
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "5%+"; allow-when-locked=true; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; allow-when-locked=true; }

    // ── Lock ──
    Mod+Ctrl+L { spawn "noctalia" "ipc" "lock"; }

    // ── Clipboard ──
    Mod+Ctrl+V { spawn "noctalia" "ipc" "clipboard" "toggle"; }

    // ── Notifications ──
    Mod+Comma { spawn "noctalia" "ipc" "notifications" "clear"; }

    // ── Overview ──
    Mod+O { overview; }

    // ── Power menu ──
    Mod+Shift+Q { spawn "noctarchy-power"; }

    // ── Noctalia-specific ──
    Mod+N { spawn "noctalia" "ipc" "notifications" "toggle"; }
    Mod+Alt+D { spawn "noctalia" "ipc" "launcher" "toggle"; }
}

// ──────────────────────────────────────────────
// Window rules
// ──────────────────────────────────────────────

// Floating dialogs
window-rule {
    app-id "pavucontrol"
    open-floating
}

window-rule {
    app-id "nm-connection-editor"
    open-floating
}

window-rule {
    app-id "blueman-manager"
    open-floating
}

window-rule {
    app-id "org.gnome.Calculator"
    open-floating
}

window-rule {
    app-id "org.gnome.Settings"
    open-floating
}

window-rule {
    app-id "feh"
    open-floating
}

window-rule {
    app-id "imv"
    open-floating
}

// Default terminal
window-rule {
    app-id "Alacritty"
    default-column-width { proportion 0.5; }
}

// File manager
window-rule {
    app-id "org.gnome.Nautilus"
    open-floating
}

// Browser — send to browser workspace
window-rule {
    app-id "firefox"
    open-on-workspace "browser"
}

window-rule {
    app-id "chromium"
    open-on-workspace "browser"
}

window-rule {
    app-id "brave-browser"
    open-on-workspace "browser"
}

// Code editors — send to code workspace
window-rule {
    app-id "code"
    open-on-workspace "code"
}

window-rule {
    app-id "jetbrains-*"
    open-on-workspace "code"
}

// Media
window-rule {
    app-id "mpv"
    open-on-workspace "media"
}

// Chat
window-rule {
    app-id "discord"
    open-on-workspace "chat"
}

window-rule {
    app-id "org.telegram.desktop"
    open-on-workspace "chat"
}

// Layer rules — blur background for bars/overlays
layer-rule {
    namespace "fuzzel"
    blur
}

layer-rule {
    namespace "noctalia"
    blur
}

// ──────────────────────────────────────────────
// Spawn at startup
// ──────────────────────────────────────────────

spawn-at-startup "noctalia"
spawn-at-startup "swayidle" "-w" "timeout" "600" "niri msg action power-off-monitors"
spawn-sh-at-startup "systemctl --user import-environment $(env | cut -d= -f1) && dbus-update-activation-environment --systemd --all"

// ──────────────────────────────────────────────
// Xwayland
// ──────────────────────────────────────────────

xwayland-satellite { path "xwayland-satellite"; }

// ──────────────────────────────────────────────
// Clipboard
// ──────────────────────────────────────────────

clipboard { disable-primary; }

// ──────────────────────────────────────────────
// Blur
// ──────────────────────────────────────────────

blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.5
}

// ──────────────────────────────────────────────
// Hotkey overlay
// ──────────────────────────────────────────────

hotkey-overlay {
    hide-not-bound
}

// ──────────────────────────────────────────────
// Config notification
// ──────────────────────────────────────────────

config-notification {
    // disable-failed
}

// ──────────────────────────────────────────────
// Screenshot path
// ──────────────────────────────────────────────

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ──────────────────────────────────────────────
// Prefer no CSD
// ──────────────────────────────────────────────

prefer-no-csd
