#!/bin/bash
# noctarchy:menu=system
# noctarchy:summary=System submenu: config, apps, fonts, network, security, kernel, splash, maintenance.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Rows ending in ">" open a submenu.
choice=$(
  printf '%s\n' \
    'Boot Splash >' \
    'Cleaner' \
    'Config >' \
    'Default Apps >' \
    'Fonts' \
    'Kernel >' \
    'Maintenance >' \
    'Network >' \
    'Security >' \
    'Snapshots' |
    "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt='System: ' --width=26 --lines=10
) || exec "$SCRIPT_DIR/noctarchy-menu"   # Esc = back to root menu
choice=${choice%' >'}

case "$choice" in
  "Boot Splash")  exec "$SCRIPT_DIR/noctarchy-splash" ;;
  Cleaner)       exec "$SCRIPT_DIR/noctarchy-cleaner" ;;
  Config)        exec "$SCRIPT_DIR/noctarchy-config" ;;
  "Default Apps") exec "$SCRIPT_DIR/noctarchy-defaults" ;;
  Fonts)         exec "$SCRIPT_DIR/noctarchy-fonts" ;;
  Kernel)        exec "$SCRIPT_DIR/noctarchy-kernel" ;;
  Maintenance)   exec "$SCRIPT_DIR/noctarchy-system-update" ;;
  Network)       exec "$SCRIPT_DIR/noctarchy-network" ;;
  Security)      exec "$SCRIPT_DIR/noctarchy-security" ;;
  Snapshots)     exec "$SCRIPT_DIR/noctarchy-snapshots" ;;
esac
