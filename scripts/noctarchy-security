#!/bin/bash
# noctarchy:security=security-setup
# noctarchy:summary=Security setup: fingerprint login, FIDO2 keys, SSH daemon, passwordless sudo
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

menu=""
declare -A cmd_for=()

add() {
  local label=$1 cond=$2
  shift 2
  [[ -n $cond ]] && ! "$cond" >/dev/null 2>&1 && return 0
  cmd_for[$label]="$*"
  menu+="$label"$'\n'
}

add 'Fingerprint'       omarchy-hw-fingerprint "$SCRIPT_DIR/noctarchy-terminal" omarchy-setup-security-fingerprint
add 'Fido2'             ''                     "$SCRIPT_DIR/noctarchy-terminal" omarchy-setup-security-fido2
add 'SSHD'              ''                     "$SCRIPT_DIR/noctarchy-terminal" omarchy-setup-security-sshd
add 'Passwordless Sudo' ''                     "$SCRIPT_DIR/noctarchy-terminal" omarchy-sudo-passwordless

choice=$(
  printf '%s' "$menu" |
    "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt='Security: ' --width=30 --lines=${#cmd_for[@]}
) || exec "$SCRIPT_DIR/noctarchy-system"

cmd=${cmd_for[$choice]:-}
[[ -n $cmd ]] && eval exec "$cmd"
