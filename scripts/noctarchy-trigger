#!/bin/bash
# noctarchy:menu=trigger
# noctarchy:summary=Trigger submenu: hardware toggles and speed tests.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Rows ending in ">" open a submenu.
choice=$(
  printf '%s\n' \
    'Hardware' |
    "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt='Trigger: ' --width=26 --lines=1
) || exec "$SCRIPT_DIR/noctarchy-menu"   # Esc = back to root menu
choice=${choice%' >'}

case "$choice" in
  "Hardware") exec "$SCRIPT_DIR/noctarchy-hardware" ;;
esac
