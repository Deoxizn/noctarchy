#!/bin/bash
# noctarchy:wallpaper-reset=wrapper
# noctarchy:summary=Reset DP-1 and HDMI-A-1 to your chosen wallpapers (undo theme resets)
# noctarchy:internal=false
set -euo pipefail

WALL_DIR="$HOME/Pictures/Wallpapers"

# Chosen per-monitor wallpapers (edit these to change the reset targets)
DP1="$WALL_DIR/wallhaven-kx996m.jpg"
HDMI="$WALL_DIR/symbols_t_black.png"

# Ensure the wallpaper dir exists
if [[ ! -d $WALL_DIR ]]; then
    echo "Wallpaper directory not found: $WALL_DIR"
    exit 1
fi

# Apply per monitor only if the file exists
if [[ -f $DP1 ]]; then
    noctalia msg wallpaper-set DP-1 "$DP1"
    echo "DP-1 → $DP1"
else
    echo "skip DP-1 (missing: $DP1)"
fi

if [[ -f $HDMI ]]; then
    noctalia msg wallpaper-set HDMI-A-1 "$HDMI"
    echo "HDMI-A-1 → $HDMI"
else
    echo "skip HDMI-A-1 (missing: $HDMI)"
fi
