#!/bin/bash
# noctarchy:themes=theme-submenu
# noctarchy:summary=Themes submenu: browse the theme list or install a new theme
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

choice=$(
  printf '%s\n' \
    'Theme list' \
    'Install theme' |
    "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt='Themes: ' --width=26 --lines=2
) || exec "$SCRIPT_DIR/noctarchy-menu"

case "$choice" in
  "Theme list")    exec "$SCRIPT_DIR/noctarchy-themes-list" ;;
  "Install theme") exec omarchy-launch-or-focus-tui --app-id=TUI.float omarchy-theme-install ;;
esac
