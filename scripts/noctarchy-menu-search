#!/bin/bash
# noctarchy:menu-search=global-search
# noctarchy:summary=Search every menu action from one picker (Super+Alt+/)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Actions-only index: every row DOES something (or opens a dynamic picker
# whose contents can't be indexed, like font/theme lists). Container-only
# drills are deliberately excluded — hierarchy lives in noctarchy-menu.
# When adding a submenu entry, add its row here too.
declare -A cmd_for=()
menu=""
add() { cmd_for[$1]="$2"; menu+="$1"$'\n'; }

# ── Capture ──
add 'Capture › OCR text from region' 'noctarchy-capture "OCR text from region"'
add 'Capture › Decode QR from region' 'noctarchy-capture "Decode QR from region"'
add 'Capture › Color picker' 'noctarchy-capture "Color picker"'
add 'Capture › Transcode media' 'noctarchy-capture "Transcode media"'

# ── Hardware ──
add 'Hardware › Restart hardware' 'noctarchy-hardware'
add 'Hardware › Speed Test › Network download' 'noctarchy-speedtest "Network download"'
add 'Hardware › Speed Test › Network upload' 'noctarchy-speedtest "Network upload"'
add 'Hardware › Speed Test › Disk' 'noctarchy-speedtest "Disk"'

# ── Packages ──
add 'Packages › Remove' 'noctarchy-remove'
add 'Packages › Install › Package' 'noctarchy-install "Package"'
add 'Packages › Install › AUR' 'noctarchy-install "AUR"'
add 'Packages › Install › Web App' 'noctarchy-install "Web App"'

# ── Reminders ──
add 'Reminders › Set a reminder' 'noctarchy-reminders "Set a reminder"'
add 'Reminders › Quick reminder' 'noctarchy-reminders "Quick reminder"'
add 'Reminders › Clear all' 'noctarchy-reminders "Clear all"'

# ── Restart ──
add 'Restart › Reload Niri' 'noctarchy-restart "Reload Niri"'
add 'Restart › Restart Noctalia' 'noctarchy-restart "Restart Noctalia"'
add 'Restart › Refresh theme' 'noctarchy-restart "Refresh theme"'

# ── Share ──
add 'Share › Clipboard' 'noctarchy-share "Clipboard"'
add 'Share › File' 'noctarchy-share "File"'
add 'Share › Folder' 'noctarchy-share "Folder"'
add 'Share › Receive' 'noctarchy-share "Receive"'

# ── System ──
add 'System › Cleaner' 'noctarchy-cleaner'
add 'System › Fonts' 'noctarchy-fonts'
add 'System › Network' 'noctarchy-network'
add 'System › Security' 'noctarchy-security'
add 'System › Snapshots' 'noctarchy-snapshots'
add 'System › Boot Splash › Adopt' 'noctarchy-terminal noctarchy-splash run adopt'
add 'System › Boot Splash › Refresh' 'noctarchy-terminal noctarchy-splash run refresh'
add 'System › Boot Splash › Status' 'noctarchy-terminal noctarchy-splash run status'
add 'System › Config › Niri config' 'noctarchy-config "Niri config"'
add 'System › Config › Noctalia config' 'noctarchy-config "Noctalia config"'
add 'System › Config › Palettes' 'noctarchy-config "Palettes"'
add 'System › Config › Hooks' 'noctarchy-config "Hooks"'
add 'System › Config › Scripts' 'noctarchy-config "Scripts"'
add 'System › Default Apps › Browser' 'noctarchy-defaults "Browser"'
add 'System › Default Apps › Editor' 'noctarchy-defaults "Editor"'
add 'System › Default Apps › Terminal' 'noctarchy-defaults "Terminal"'
add 'System › Default Apps › Agent' 'noctarchy-defaults "Agent"'
add 'System › Kernel › Default (CachyOS)' 'noctarchy-terminal noctarchy-kernel run default'
add 'System › Kernel › BORE (gaming)' 'noctarchy-terminal noctarchy-kernel run bore'
add 'System › Kernel › EEVDF' 'noctarchy-terminal noctarchy-kernel run eevdf'
add 'System › Kernel › LTS' 'noctarchy-terminal noctarchy-kernel run lts'
add 'System › Kernel › Real-time BORE' 'noctarchy-terminal noctarchy-kernel run rt-bore'
add 'System › Kernel › Status and repair' 'noctarchy-terminal noctarchy-kernel run status'
add 'System › Maintenance › Drive encryption password' 'noctarchy-system-update "Drive encryption password"'
add 'System › Maintenance › User password' 'noctarchy-system-update "User password"'
add 'System › Maintenance › Sync system clock' 'noctarchy-system-update "Sync system clock"'
add 'System › Maintenance › Reset Plymouth config' 'noctarchy-system-update "Reset Plymouth config"'
add 'System › Maintenance › Reset tmux config' 'noctarchy-system-update "Reset tmux config"'
add 'System › Network › Wi-Fi QR Code' 'noctarchy-network "Wi-Fi QR Code"'

# ── System Update ──
add 'System Update › Noctarchy' 'noctarchy-update "Noctarchy"'
add 'System Update › Channel' 'noctarchy-update "Channel"'
add 'System Update › Extra themes' 'noctarchy-update "Extra themes"'
add 'System Update › Firmware' 'noctarchy-update "Firmware"'
add 'System Update › Repo sync' 'noctarchy-update "Repo sync"'
add 'System Update › Restart Audio' 'noctarchy-update-hardware "Audio"'
add 'System Update › Restart Wi-Fi' 'noctarchy-update-hardware "Wi-Fi"'
add 'System Update › Restart Bluetooth' 'noctarchy-update-hardware "Bluetooth"'
add 'System Update › Restart Trackpad' 'noctarchy-update-hardware "Trackpad"'

# ── Themes ──
add 'Themes › Theme list' 'noctarchy-themes-list'
add 'Themes › Install theme' 'noctarchy-themes "Install theme"'
add 'Themes › Palette source' 'noctarchy-themes "Palette source"'

choice=$(
  printf '%s' "$menu" |
    "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt='☽ Search ✦ ' --width=50 --lines=20
) || exit 0

cmd=${cmd_for[$choice]:-}
[[ -n $cmd ]] && eval "exec $cmd"
