#!/bin/bash
# noctarchy:power=session-power-menu
# noctarchy:summary=Power menu — lock, logout, suspend, hibernate, reboot, shutdown
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

choice=$(printf '%s\n' \
    "Screensaver" \
    "Stop Screensaver" \
    "Lock" \
    "Logout" \
    "Suspend" \
    "Hibernate" \
    "Reboot" \
    "Shutdown" | "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt='Power: ' --width=28 --lines=8)

[[ -z "$choice" ]] && exit 0

confirm() {
    local action="$1"
    local result
    result=$(printf '%s\n' Confirm Cancel | "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt="$action: " --width=16 --lines=2)
    [[ "$result" == "Confirm" ]]
}

do_action() {
    case "$choice" in
        Screensaver)      $(grep '^terminal' ~/.config/noctalia/config.toml | cut -d'"' -f2) bash ~/.config/niri/scripts/screensaver.sh & ;;
        Stop\ Screensaver) pkill -x ttfx 2>/dev/null; niri msg action power-on-monitors 2>/dev/null || true ;;
        Lock)             niri msg action lock 2>/dev/null || loginctl lock-session ;;
        Logout)       niri msg action quit ;;
        Suspend)      systemctl suspend ;;
        Hibernate)    systemctl hibernate ;;
        Reboot)       confirm "Reboot" && omarchy-system-reboot ;;
        Shutdown)     confirm "Shutdown" && omarchy-system-shutdown ;;
    esac
}

do_action
