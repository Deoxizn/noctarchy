#!/bin/bash
# noctarchy:menu=root
# noctarchy:summary=Root application menu — dispatches to sub-menus
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

choice=$(
  printf '%s\n' \
    'Packages >' \
    'Config >' \
    'Restart >' \
    'Setup >' \
    'Share >' \
    'System >' \
    'Themes >' \
    'Trigger >' \
    'Update >' |
    "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt='☽ Noctarchy ✦ ' --width=28 --lines=9
) || exit 0
choice=${choice%' >'}

case "$choice" in
  Packages) exec "$SCRIPT_DIR/noctarchy-packages" ;;
  Config)   exec "$SCRIPT_DIR/noctarchy-config" ;;
  Restart)  exec "$SCRIPT_DIR/noctarchy-restart" ;;
  Setup)    exec "$SCRIPT_DIR/noctarchy-setup" ;;
  Share)    exec "$SCRIPT_DIR/noctarchy-share" ;;
  System)   exec "$SCRIPT_DIR/noctarchy-system" ;;
  Themes)   exec "$SCRIPT_DIR/noctarchy-themes" ;;
  Trigger)  exec "$SCRIPT_DIR/noctarchy-trigger" ;;
  Update)   exec "$SCRIPT_DIR/noctarchy-update" ;;
esac
