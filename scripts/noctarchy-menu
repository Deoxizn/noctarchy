#!/bin/bash
# noctarchy:menu=root
# noctarchy:summary=Root application menu — dispatches to sub-menus
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

choice=$(
  printf '%s\n' \
    'Capture >' \
    'Packages >' \
    'Reminders >' \
    'Restart >' \
    'Setup >' \
    'Share >' \
    'System >' \
    'Themes >' \
    'Hardware >' \
    'System Update >' |
    "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt='☽ Noctarchy ✦ ' --width=28 --lines=10
) || exit 0
choice=${choice%' >'}

case "$choice" in
  Capture)       exec "$SCRIPT_DIR/noctarchy-capture" ;;
  Packages)     exec "$SCRIPT_DIR/noctarchy-packages" ;;
  Reminders)     exec "$SCRIPT_DIR/noctarchy-reminders" ;;
  Restart)      exec "$SCRIPT_DIR/noctarchy-restart" ;;
  Setup)        exec "$SCRIPT_DIR/noctarchy-setup" ;;
  Share)        exec "$SCRIPT_DIR/noctarchy-share" ;;
  System)       exec "$SCRIPT_DIR/noctarchy-system" ;;
  Themes)       exec "$SCRIPT_DIR/noctarchy-themes" ;;
  Hardware)     exec "$SCRIPT_DIR/noctarchy-trigger" ;;
  "System Update") exec "$SCRIPT_DIR/noctarchy-update" ;;
esac
