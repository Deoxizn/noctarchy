#!/bin/bash
# noctarchy:menu=root
# noctarchy:summary=Root application menu — dispatches to sub-menus
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

choice=$(echo -e "Packages >\nRestart >\nSetup >\nSystem >\nThemes >\nTrigger >\nUpdate >" | "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt="Menu: ")

case "$choice" in
    "Packages >")  exec "$SCRIPT_DIR/noctarchy-packages" 2>/dev/null || notify-send "Noctarchy" "Packages menu not found" ;;
    "Restart >")   exec "$SCRIPT_DIR/noctarchy-restart" ;;
    "Setup >")     exec "$SCRIPT_DIR/noctarchy-config" ;;
    "System >")    exec "$SCRIPT_DIR/noctarchy-power" ;;
    "Themes >")    exec "$SCRIPT_DIR/noctarchy-themes" ;;
    "Trigger >")   exec "$SCRIPT_DIR/noctarchy-trigger" 2>/dev/null || notify-send "Noctarchy" "Trigger menu not found" ;;
    "Update >")    exec "$SCRIPT_DIR/noctarchy-update" ;;
esac
