#!/bin/bash
# noctarchy:terminal=floating-runner
# noctarchy:summary=Run a command in the default terminal (via xdg-terminal-exec) with uniform app-id
set -euo pipefail

APP_ID="noctarchy-terminal"

if ! command -v xdg-terminal-exec &>/dev/null; then
    notify-send "Noctarchy" "xdg-terminal-exec not found"
    exit 1
fi

if [[ $# -gt 0 ]]; then
    # One-shot command: hold the window open via noctarchy-hold so output
    # stays visible (spawned terminals close on exit). Per-script holds are
    # unnecessary — and would double-prompt.
    exec xdg-terminal-exec --app-id="$APP_ID" -- noctarchy-hold "$@"
fi

# No args: open interactive shell (no hold — your shell stays open itself)
exec xdg-terminal-exec --app-id="$APP_ID"
