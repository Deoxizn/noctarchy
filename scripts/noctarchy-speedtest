#!/bin/bash
# noctarchy:speedtest=speed-tests
# noctarchy:summary=Speed tests: network down/up and disk
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ $# -gt 0 ]]; then
  # Direct dispatch from menu search
  choice="$*"
else
choice=$(
  printf '%s\n' \
    'Network download' \
    'Network upload' \
    'Disk' |
    "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt='Speed test: ' --width=26 --lines=3
) || exec "$SCRIPT_DIR/noctarchy-menu"
fi

case "$choice" in
  "Network download") exec omarchy-launch-webapp 'https://fast.com' ;;
  "Network upload")   exec omarchy-launch-webapp 'https://fast.com' ;;
  Disk)               exec xdg-terminal-exec --app-id=TUI.float -e omarchy-disk-speedtest ;;
esac
