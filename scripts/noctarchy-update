#!/bin/bash
# noctarchy:summary=Update menu: system, channel, themes, restarts, firmware, repo sync.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

current=$(omarchy channel current 2>/dev/null)

# Rows ending in ">" drill into another picker; bare rows act immediately.
entries=("Noctarchy" "Channel${current:+ ($current)} >")
omarchy-theme-extras >/dev/null 2>&1 && entries+=('Extra themes')
entries+=('Hardware >' 'Firmware' 'Repo sync')

choice=$(
  printf '%s\n' "${entries[@]}" |
    "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt='Update: ' --width=30 --lines=${#entries[@]}
) || exec "$SCRIPT_DIR/noctarchy-menu"   # Esc = back to root menu
choice=${choice%' >'}

case "$choice" in
  Noctarchy)      exec omarchy-launch-or-focus-tui --app-id=TUI.float omarchy-update ;;
  "Extra themes") exec omarchy-launch-or-focus-tui --app-id=TUI.float omarchy-theme-update ;;
  Hardware)       exec "$SCRIPT_DIR/noctarchy-update-hardware" ;;
  Firmware)       exec omarchy-launch-or-focus-tui --app-id=TUI.float omarchy-update-firmware ;;
  "Repo sync")    exec "$SCRIPT_DIR/noctarchy-repo-sync" ;;
  Channel*) ;;
  *) exit 0 ;;
esac

# Channel picker; switching needs sudo, so run it in a terminal.
chan_choice=$(
  printf '%s\n' stable rc edge dev |
    awk -v cur="$current" '$0 == cur { print "✓ " $0; next } { print }' |
    "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt='Channel: ' --width=22 --lines=4
) || exec "$SCRIPT_DIR/noctarchy-update"   # Esc = back to Update menu

channel=${chan_choice#✓ }
[[ -n $channel ]] && exec omarchy-launch-or-focus-tui --app-id=TUI.float omarchy-channel-set "$channel"
