#!/bin/bash
# System-wide wrapper for noctarchy-splash hook
# Checks if theme is already noctarchy, then finds and calls user's script
set -euo pipefail

# Skip if theme is already noctarchy
grep -q "^Theme=noctarchy" /etc/plymouth/plymouthd.conf 2>/dev/null && exit 0

# Find noctarchy-splash for the invoking user
for user_home in /home/*; do
  # Check ~/.local/bin (standard location for other machines)
  SPLASH_BIN="$user_home/.local/bin/noctarchy-splash"
  if [[ -x "$SPLASH_BIN" ]]; then
    "$SPLASH_BIN" run adopt
    exit $?
  fi
  # Check ~/Work/noctarchy/scripts (dev machine)
  SPLASH_BIN="$user_home/Work/noctarchy/scripts/noctarchy-splash"
  if [[ -x "$SPLASH_BIN" ]]; then
    "$SPLASH_BIN" run adopt
    exit $?
  fi
done

echo "[noctarchy-splash] noctarchy-splash not found for any user" >&2
exit 1
