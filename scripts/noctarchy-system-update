#!/bin/bash
# noctarchy:menu=system-update
# noctarchy:summary=System update submenu: passwords, clock sync, plymouth/tmux reset, cleaners
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ $# -gt 0 ]]; then
  # Direct dispatch from menu search
  choice="$*"
else
choice=$(
  printf '%s\n' \
    'Drive encryption password' \
    'Reset Plymouth config' \
    'Reset tmux config' \
    'Snapshot Manager' \
    'Sync system clock' \
    'System Cleaner' \
    'User password' |
    "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt='Update: ' --width=32 --lines=7
) || exec "$SCRIPT_DIR/noctarchy-system"   # Esc = back to System menu
fi

case "$choice" in
  "Drive encryption password") exec xdg-terminal-exec --app-id=TUI.float -e noctarchy-hold omarchy-drive-password ;;
  "Reset Plymouth config")     exec xdg-terminal-exec --app-id=TUI.float -e noctarchy-hold omarchy-refresh-plymouth ;;
  "Reset tmux config")         exec xdg-terminal-exec --app-id=TUI.float -e noctarchy-hold omarchy-refresh-tmux ;;
  "Snapshot Manager")          exec "$SCRIPT_DIR/noctarchy-snapshots" ;;
  "Sync system clock")         exec xdg-terminal-exec --app-id=TUI.float -e noctarchy-hold omarchy-update-time ;;
  "System Cleaner")            exec "$SCRIPT_DIR/noctarchy-cleaner" ;;
  "User password")             exec xdg-terminal-exec --app-id=TUI.float -e noctarchy-hold passwd ;;
esac
