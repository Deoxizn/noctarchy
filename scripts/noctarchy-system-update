#!/bin/bash
# noctarchy:menu=system-update
# noctarchy:summary=System update submenu: passwords, clock sync, plymouth/tmux reset
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ $# -gt 0 ]]; then
  # Direct dispatch from menu search
  choice="$*"
else
choice=$(
  printf '%s\n' \
    'Drive encryption password' \
    'User password' \
    'Sync system clock' \
    'Reset Plymouth config' \
    'Reset tmux config' |
    "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt='Update: ' --width=32 --lines=5
) || exec "$SCRIPT_DIR/noctarchy-system"   # Esc = back to System menu
fi

case "$choice" in
  "Drive encryption password") exec xdg-terminal-exec --app-id=TUI.float -e omarchy-drive-password ;;
  "User password")             exec xdg-terminal-exec --app-id=TUI.float -e passwd ;;
  "Sync system clock")         exec xdg-terminal-exec --app-id=TUI.float -e omarchy-update-time ;;
  "Reset Plymouth config")     exec xdg-terminal-exec --app-id=TUI.float -e omarchy-refresh-plymouth ;;
  "Reset tmux config")         exec xdg-terminal-exec --app-id=TUI.float -e omarchy-refresh-tmux ;;
esac
