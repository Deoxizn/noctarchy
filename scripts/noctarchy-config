#!/bin/bash
# noctarchy:menu=config
# noctarchy:summary=Edit Noctarchy config files
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

choice=$(
  printf '%s\n' \
    'Niri config' \
    'Noctalia config' \
    'Palettes' \
    'Hooks' \
    'Scripts' |
    "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt='Config: ' --width=24 --lines=5
) || exec "$SCRIPT_DIR/noctarchy-menu"

case "$choice" in
  'Niri config')     xdg-terminal-exec -e "${EDITOR:-nvim}" "${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl" ;;
  'Noctalia config') xdg-terminal-exec -e "${EDITOR:-nvim}" "${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/config.toml" ;;
  'Palettes')        xdg-terminal-exec -e "${EDITOR:-nvim}" "${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/palettes/" ;;
  'Hooks')           xdg-terminal-exec -e "${EDITOR:-nvim}" "${XDG_DATA_HOME:-$HOME/.local/share}/noctarchy/hooks/" ;;
  'Scripts')         xdg-terminal-exec -e "${EDITOR:-nvim}" "${XDG_DATA_HOME:-$HOME/.local/share}/noctarchy/scripts/" ;;
esac
