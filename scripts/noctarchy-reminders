#!/bin/bash
# noctarchy:menu=reminders
# noctarchy:summary=Reminders submenu: set, quick, clear
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ $# -gt 0 ]]; then
  # Direct dispatch from menu search
  choice="$*"
else
choice=$(
  printf '%s\n' \
    'Set a reminder' \
    'Quick reminder' \
    'Clear all' |
    "$SCRIPT_DIR/noctarchy-fuzzel" --dmenu --prompt='Reminders: ' --width=32 --lines=3
) || exec "$SCRIPT_DIR/noctarchy-menu"   # Esc = back to root menu
fi

case "$choice" in
  "Set a reminder") exec xdg-terminal-exec --app-id=TUI.float -e noctarchy-hold omarchy-reminder -i ;;
  "Quick reminder") exec xdg-terminal-exec --app-id=TUI.float -e noctarchy-hold bash -c 'read -rp "Reminder (e.g. 30 \"Check the oven\"): " input; omarchy-reminder $input' ;;
  "Clear all")      exec xdg-terminal-exec --app-id=TUI.float -e noctarchy-hold omarchy-reminder clear ;;
esac
